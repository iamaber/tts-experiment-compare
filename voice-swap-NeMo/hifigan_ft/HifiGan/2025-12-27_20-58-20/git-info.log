     "# This improves audio quality by training the vocoder on synthesized mels from the finetuned FastPitch\n",
     "\n",
     "!(python hifigan_finetune.py --config-name=hifigan \\\n",
+    "  +init_from_pretrained_model=tts_en_hifigan \\\n",
     "  train_dataset=./hifigan_train_ft.json \\\n",
-    "  validation_datasets=./hifigan_val_ft.json \\\n",
